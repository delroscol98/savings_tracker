# Postgres connection string used by the server (loaded in main.go)
DB_URL=postgres://USER:PASSWORD@localhost:5432/savings_tracker?sslmode=disable

# Postgres connection string used by the integration tests in api/
DB_URL_TEST=postgres://USER:PASSWORD@localhost:5432/savings_tracker_test?sslmode=disable

# Resend API key used to send password reset emails (api/users/resend.go)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From address for outgoing reset emails
FROM_EMAIL=Savings Tracker <noreply@example.com>

# Secret used to sign and verify JWTs (internal/auth/jwt.go). Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Base URL used to build password reset links. Required; the server exits if unset.
BASE_URL=http://localhost:8080
